# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and adjust the variables for your environment.
# ==============================================================================

# Application Configuration
PROJECT_NAME="Text-to-SQL Clarification Engine API"
VERSION="1.0.0"
DEBUG=false
LOG_LEVEL="INFO"

# Database Credentials
DB_NAME=text_to_sql_store
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Connection Pool & Query Limits
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10
DB_STATEMENT_TIMEOUT_MS=5000
SCHEMA_CACHE_TTL_SECONDS=300
MAX_QUERY_LIMIT=10
MAX_ALLOWED_LIMIT=100

# ==============================================================================
# LLM Provider Configuration (Default: Google Gemini - Free & Fast)
# Get your free key at: https://aistudio.google.com/app/apikey
# ==============================================================================
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# Alternative Providers:
# 1. Groq (Free & Fast):
#    LLM_PROVIDER=groq
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_API_KEY=gsk_...
#    LLM_MODEL=llama-3.3-70b-versatile
# 2. Local Ollama:
#    LLM_PROVIDER=ollama
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=llama3.2
# 3. OpenAI:
#    LLM_PROVIDER=openai
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_API_KEY=sk-...
#    LLM_MODEL=gpt-4o-mini

# API Security (Optional)
API_KEY_ENABLED=false
API_KEY=
RATE_LIMIT_PER_MINUTE=60